{
  "train_data": "./data/train.json",
  "dev_data": "./data/dev.json",
  "eval_data": "./data/test.json",
  "model_path": "./model/Qwen2.5-7B",
  "output_dir": "./outputs/lora_weights/all_linear",
  "train_mode": "lora",
  "batch_size": 4,
  "dev_batch_size": 4,
  "eval_batch_size": 4,
  "gradient_accumulation_steps": 1,
  "epochs":9,
  "patience": 3,
  "learning_rate": 0.00002,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "max_len": 512,
  "max_new_tokens":256,
  "warmup_ratio": 0.1,
  "gradient_checkpointing": true,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "system_prompt": "You are an expert biomedical NER system. Extract gene entities from the user sentence. Output strictly valid JSON in this format: {\"entities\":[{\"name\":\"GeneA\",\"type\":\"GENE\"}]}. Do not output explanations or any text outside the JSON object.",
  "seed": 42

}
