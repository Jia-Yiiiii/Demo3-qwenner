{
  "train_data": "./data/train.json",
  "dev_data": "./data/dev.json",
  "eval_data": "./data/test.json",
  "model_name": "Qwen2.5-7B",
  "model_path": "./model/Qwen2.5-7B",
  "output_dir": "./outputs/qlora_weights/all_linear",
  "cache_dir": "./model",
  "trained_save_root_path": "./logs",
  "train_mode": "qlora",
  "batch_size": 4,
  "dev_batch_size": 4,
  "eval_batch_size": 4,
  "gradient_accumulation_steps": 1,
  "epochs": 12,
  "patience": 5,
  "learning_rate": 5e-5,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "max_len": 400,
  "max_new_tokens": 128,
  "warmup_ratio": 0.1,
  "mixed_precision": "bf16",
  "torch_dtype": "bfloat16",
  "gradient_checkpointing": true,
  "model_config_use_cache": false,

  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
 "system_prompt": "You are an expert biomedical NER system. Extract gene entities from the user sentence. Output strictly valid JSON in this format: {\"entities\":[{\"name\":\"GeneA\",\"type\":\"GENE\"}]}. Do not output explanations or any text outside the JSON object.",
  "seed": 42,
  "bnb_4bit_quant_type": "nf4",
  "bnb_4bit_compute_dtype": "bfloat16",
  "bnb_4bit_use_double_quant": true,
  "load_in_4bit": true,
  "trust_remote_code": true
}